{
  "realm": "zeus",
  "enabled": true,
  "sslRequired": "none",
  "loginTheme": "zeus",
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Dono/admin Horizon. Acesso total: LGPD, usuários, termos, uploads e áreas analíticas."
      },
      {
        "name": "MANAGER",
        "description": "Administrador Tecsys. Pode operar o sistema, fazer uploads e análises. Sem acesso a usuários, termos ou rotas LGPD."
      },
      {
        "name": "ANALYST",
        "description": "Operacional/visualizador. Acessa dashboards, heatmap, estrutura de redes e próprios dados. Sem gestão administrativa nem upload."
      }
    ]
  },
  "clients": [
    {
      "clientId": "zeus-frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/"
      },
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "false",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "zeus-backend",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "zeus-backend-secret-dev"
    }
  ],
  "users": [
    {
      "username": "service-account-zeus-backend",
      "enabled": true,
      "serviceAccountClientId": "zeus-backend",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "query-realms"
        ]
      }
    }
  ]
}
