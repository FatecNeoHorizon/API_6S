# Application Configuration
APP_ENV=dev
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept,Origin,X-Requested-With
TMP_UPLOAD_PATH=/app/tmp
GDB_FILE_PATH=geodatabase.gdb

# MongoDB Connection Settings
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_USER=
MONGO_PASSWORD=
MONGO_DB_NAME=tecsys

# Security Configuration
EMAIL_HASH_SALT=
# RSA-2048 key pair for JWT RS256 signing (PEM encoded, use \n for line breaks)
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Keycloak — see envs/.env.keycloak.dev and envs/.env.keycloak-postgres.dev
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=zeus
KEYCLOAK_CLIENT_ID=zeus-frontend
# Backend service account (client_credentials grant — configure in Keycloak realm)
KEYCLOAK_BACKEND_CLIENT_ID=zeus-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=

# SMTP Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=yourpassword
SMTP_FROM=noreply@example.com

# MongoDB Connection Pool Settings (timeouts in milliseconds)
MONGO_MAX_POOL_SIZE=10
MONGO_SERVER_SELECTION_TIMEOUT_MS=120000
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_QUERY_MAX_TIME_MS=30000

# ETL Configuration
ETL_BULK_BATCH_SIZE=1000
